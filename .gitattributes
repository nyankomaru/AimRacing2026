# ============================================================
# Default
# ============================================================
* text=auto
# ============================================================
# Unity text assets
# ============================================================
*.meta                  text eol=lf
*.unity                 text eol=lf
*.prefab                text eol=lf
*.asset                 text eol=lf
*.mat                   text eol=lf
*.anim                  text eol=lf
*.controller            text eol=lf
*.overrideController    text eol=lf
*.playable              text eol=lf
*.asmdef                text eol=lf
*.asmref                text eol=lf
# ============================================================
# Source code
# ============================================================
*.cs                    text eol=lf
*.cpp                   text eol=lf
*.c                     text eol=lf
*.cc                    text eol=lf
*.cxx                   text eol=lf
*.h                     text eol=lf
*.hpp                   text eol=lf
*.inl                   text eol=lf
# ============================================================
# Shaders
# ============================================================
*.shader                text eol=lf
*.compute               text eol=lf
*.cginc                 text eol=lf
*.hlsl                  text eol=lf
*.glsl                  text eol=lf
# ============================================================
# Text / Config / Data
# ============================================================
*.txt                   text eol=lf
*.md                    text eol=lf
*.json                  text eol=lf
*.xml                   text eol=lf
*.yaml                  text eol=lf
*.yml                   text eol=lf
*.ini                   text eol=lf
*.cfg                   text eol=lf
*.config                text eol=lf
*.csv                   text eol=lf
*.tsv                   text eol=lf
*.uxml                  text eol=lf
*.uss                   text eol=lf
# ============================================================
# Scripts
# ============================================================
*.bat                   text eol=crlf
*.cmd                   text eol=crlf
*.ps1                   text eol=crlf
*.sh                    text eol=lf
# ============================================================
